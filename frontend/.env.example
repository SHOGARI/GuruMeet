# ローカルのフロントエンド開発用。
# 使うときは `cp .env.example .env` でコピーする。
# `.env` 本体はコミットしない。
#
# Flutter 側では `--dart-define` で同じキーを渡す。

# Flutter Web のローカル起動ポート。
# `make dev` / `make dev-chrome` がこの値を読む。
FRONTEND_PORT=3000

# API の接続先。
#
# 通常のローカル開発:
#   http://localhost:8000
#   backend/compose.yaml で立てた FastAPI コンテナを直接呼ぶ。
#
# Worker 経由も含めて確認したい場合:
#   http://localhost:8787/api
#   `wrangler dev` を起動して、frontend -> Worker -> FastAPI の経路を見る。
#   localhost の `wrangler dev` は通常 Cloudflare 本番アクセス数には入らない。
#
# 課金対象になる確認:
#   https://stg.gurumeet.net
#   https://gurumeet.net
#   Cloudflare 上に deploy 済みの Worker / Container / R2 を使う。
GURUMEET_API_BASE_URL=http://localhost:8000

# 招待URLのベースURL。
# 未指定の場合はFlutter Webを開いているoriginを使う。
# 本番buildでは公開URLを `--dart-define` で渡す。
GURUMEET_INVITE_BASE_URL=http://localhost:3000

# true ならローカル UI 開発でモックデータを使う。
# false なら上の API 接続先を使う。
GURUMEET_ENABLE_MOCKS=true

# true なら作成完了画面などで固定デモ用の招待コードを使う。
# 公開 build では false にする。
DEMO_MODE=true
DEMO_ROOM_CODE=G7M24
