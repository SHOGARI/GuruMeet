# ローカルのバックエンド開発用。
# 使うときは `cp .env.example .env` でコピーする。
# `.env` 本体はコミットしない。

# Hot Pepper グルメサーチ API の認証に使う。
# GURUMEET_ENABLE_MOCK_RESTAURANTS=true のままなら空でよい。
HOTPEPPER_API_KEY=

# backend/compose.yaml でホスト側に公開するポート。
# ブラウザや curl からは http://localhost:8000 で FastAPI にアクセスする。
API_PORT=8000

# ローカル PostgreSQL コンテナを作るための値。
# backend/compose.yaml の db コンテナと api コンテナが使う。
POSTGRES_DB=gurumeet
POSTGRES_USER=gurumeet
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# 一時グループ招待コード機能の設定。
TEMPORARY_GROUP_CODE_MAX_ATTEMPTS=20
JOIN_RATE_LIMIT_REQUESTS=10
JOIN_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOW_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080"]'
GURUMEET_ENABLE_MOCK_RESTAURANTS=true
GURUMEET_HOTPEPPER_STATION_SEARCH_RADIUS_METERS=1000
GURUMEET_HOTPEPPER_MUNICIPALITY_SEARCH_RADIUS_METERS=3000
# 生成例: openssl rand -hex 32
# 本番では必ず別の長いランダム値に変え、Gitにコミットしない。
PARTICIPANT_TOKEN_HASH_SECRET=change_me_to_a_long_random_value
# Cloudflare Cronなど、内部運用タスクを呼ぶための秘密値。
# 生成例: openssl rand -hex 32
INTERNAL_TASK_SECRET=change_me_to_a_long_random_internal_secret

# Discord slash command `/delete staging` / `/delete production` 用。
# staging / production では GitHub Environment secrets / vars に同じ名前で登録する。
# Discord Developer Portal:
#   DISCORD_APPLICATION_ID: General Information の Application ID
#   DISCORD_APPLICATION_PUBLIC_KEY: General Information の Public Key
#   DISCORD_BOT_TOKEN: Bot の Token
#   Interactions Endpoint URL: https://gurumeet.net/discord/interactions
# 実行許可ユーザーIDは Discord の Developer Mode で対象ユーザーを右クリックしてコピーする。
DISCORD_APPLICATION_ID=
DISCORD_APPLICATION_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_DELETE_COMMAND_ALLOWED_USER_IDS=
# Worker間転送用。staging / production で同じ長いランダム値を使う。
# 生成例: openssl rand -hex 32
DISCORD_CLEANUP_FORWARD_SECRET=change_me_to_a_long_random_discord_cleanup_forward_secret
DISCORD_STAGING_CLEANUP_URL=https://gurumeet-staging.<account-subdomain>.workers.dev/edge/internal/cleanup-expired-temporary-groups
DISCORD_PRODUCTION_CLEANUP_URL=https://gurumeet.net/edge/internal/cleanup-expired-temporary-groups

# Discord alert用Incoming Webhook URL。不要なlocal開発では空でよい。
DISCORD_ALERT_WEBHOOK_URL=

# 過大なリクエストを拒否する上限。デフォルトは1MiB。
REQUEST_BODY_MAX_BYTES=1048576

# 補足:
# 通常の `docker compose up` では DATABASE_URL は不要。
# api コンテナは Compose 側から POSTGRES_HOST=db を受け取り、
# 上の POSTGRES_* から接続 URL を組み立てる。
#
# FastAPI を Compose の外で直接起動する場合だけ、
# 必要に応じて DATABASE_URL をシェルに export する。
# 例: postgresql://gurumeet:change_me@localhost:5432/gurumeet
